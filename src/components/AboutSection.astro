---
// 所属・学習内容・技術領域サマリーセクション（装飾ゲージを使わず、端正な定義リストで構成）
import { LEARNING_TOPICS, TECH_SUMMARY } from '../data/portfolio';
---

<section id="about" aria-labelledby="about-heading" class="mx-auto max-w-[1400px] px-6 sm:px-10 lg:px-10 xl:px-14">
  <div class="border-t border-line py-20 sm:py-28">
    <div class="grid grid-cols-1 gap-y-10 md:grid-cols-12 md:gap-x-12">
      <div class="md:col-span-4">
        <h2
          id="about-heading"
          class="font-serif text-xl tracking-[0.08em] text-ink sm:text-2xl"
        >
          学習と取り組み
        </h2>
      </div>

      <div class="max-w-3xl md:col-span-8">
        <dl class="divide-y divide-line">
          {
            LEARNING_TOPICS.map((topic, index) => (
              <div
                class:list={[
                  'grid grid-cols-1 gap-y-1.5 sm:grid-cols-12 sm:gap-x-6',
                  index === 0 ? 'pb-6' : index === LEARNING_TOPICS.length - 1 ? 'pt-6' : 'py-6',
                ]}
              >
                <dt class="text-xs tracking-[0.06em] text-ink/70 sm:col-span-4 sm:pt-1">
                  {topic.label}
                </dt>
                <dd class="text-sm leading-relaxed text-ink sm:col-span-8 sm:text-[0.95rem]">
                  {topic.detail}
                </dd>
              </div>
            ))
          }
        </dl>

        <div class="mt-14 border-t border-line pt-12">
          <h3 class="font-serif text-lg tracking-[0.06em] text-ink sm:text-xl">
            技術領域
          </h3>

          <dl class="mt-6 divide-y divide-line">
            {
              TECH_SUMMARY.map((row, index) => (
                <div
                  class:list={[
                    'grid grid-cols-1 gap-y-1.5 sm:grid-cols-12 sm:gap-x-6',
                    index === 0 ? 'pb-5' : index === TECH_SUMMARY.length - 1 ? 'pt-5' : 'py-5',
                  ]}
                >
                  <dt class="text-xs tracking-[0.06em] text-ink/70 sm:col-span-4 sm:pt-0.5">
                    {row.category}
                  </dt>
                  <dd class="text-sm leading-relaxed text-ink sm:col-span-8 sm:text-[0.95rem]">
                    {row.items}
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </div>
  </div>
</section>
