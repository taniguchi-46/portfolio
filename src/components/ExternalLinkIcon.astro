---
// 線幅と形状を統一した外部リンク用ミニマル SVG アイコン
interface Props {
  class?: string;
}

const { class: className = 'h-3.5 w-3.5' } = Astro.props;
---

<svg
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
>
  <path d="M5 11L11 5" />
  <path d="M6.25 5H11V9.75" />
</svg>
