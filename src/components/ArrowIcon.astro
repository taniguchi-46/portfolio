---
// 線幅を ExternalLinkIcon と統一した左右矢印用ミニマル SVG アイコン
interface Props {
  direction?: 'left' | 'right';
  class?: string;
}

const { direction = 'right', class: className = 'h-3.5 w-3.5' } = Astro.props;
---

<svg
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
>
  {
    direction === 'left' ? (
      <>
        <path d="M12.5 8H3.5" />
        <path d="M7.25 4.25L3.5 8L7.25 11.75" />
      </>
    ) : (
      <>
        <path d="M3.5 8H12.5" />
        <path d="M8.75 4.25L12.5 8L8.75 11.75" />
      </>
    )
  }
</svg>
