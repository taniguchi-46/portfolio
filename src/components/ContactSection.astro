---
// 連絡先セクション（就活用・学校用メールと GitHub を用途別に静かに配置）
import { CONTACTS } from '../data/portfolio';
import ExternalLinkIcon from './ExternalLinkIcon.astro';
---

<section
  id="contact"
  aria-labelledby="contact-heading"
  class="mx-auto max-w-[1400px] px-6 sm:px-10 lg:px-10 xl:px-14"
>
  <div class="border-t border-line py-20 sm:py-28">
    <div class="grid grid-cols-1 gap-y-10 md:grid-cols-12 md:gap-x-12">
      <div class="md:col-span-4">
        <h2
          id="contact-heading"
          class="font-serif text-xl tracking-[0.08em] text-ink sm:text-2xl"
        >
          連絡先
        </h2>
      </div>

      <div class="max-w-3xl md:col-span-8">
        <dl class="divide-y divide-line">
          {
            CONTACTS.map((contact, index) => (
              <div
                class:list={[
                  'grid grid-cols-1 gap-y-1.5 sm:grid-cols-12 sm:items-baseline sm:gap-x-6',
                  index === 0 ? 'pb-6' : index === CONTACTS.length - 1 ? 'pt-6' : 'py-6',
                ]}
              >
                <dt class="text-xs tracking-[0.06em] text-ink/70 sm:col-span-5">
                  {contact.label}
                </dt>
                <dd class="sm:col-span-7">
                  <a
                    href={contact.href}
                    target={contact.external ? '_blank' : undefined}
                    rel={contact.external ? 'noopener noreferrer' : undefined}
                    class="editorial-link text-sm break-all sm:text-[0.95rem] sm:break-normal"
                  >
                    <span>{contact.displayValue}</span>
                    {contact.external && <ExternalLinkIcon />}
                  </a>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>
